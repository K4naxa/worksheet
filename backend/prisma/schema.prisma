// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


  enum MealLocation {
    home
    work
    other
  }



model User {
  // id is the primary key, generated by Keycloak
  // it is synced with Keycloak, so it should not be changed manually
  id        String   @id

 // synced with Keycloak
  email     String   @unique
  name      String

  // this is used to check if the user has completed their registration
  // it is set to true after the user has filled in their company, instructor
  registrationCompleted Boolean @default(false)

  company   String?
  instructor String?
  start_date DateTime?
  end_date DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  workdays Workday[]
}

// Workday model for storing users loged workdays
// Users statistics count the values from the users Workdays
  model Workday{
    id String @id @default(uuid())
    date DateTime
    activities String
    learnings String
    mealLocation MealLocation // uses MealLocation enum
    mealLocationOther String? // Optional, only if mealLocation is "other"
    hours Int

    userId String
    user User @relation(fields: [userId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime? @updatedAt
  }
